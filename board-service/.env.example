APP_NAME=board-service
NODE_ENV=development
PORT=8002

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=board_db

# Must match the user-service's JWT_SECRET_KEY exactly — board-service
# verifies the same access tokens the user-service issues.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

USER_SERVICE_URL=http://localhost:8000
NOTIFICATION_SERVICE_URL=http://localhost:8001
UPLOADS_BASE_URL=http://localhost:8002/uploads

ALLOWED_ORIGINS=http://localhost:5173
